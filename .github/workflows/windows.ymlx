name: x64

on: [push, pull_request]

env:
  BOINC_DIR: ./boinc

jobs:
  build:
    runs-on: ubuntu-latest
    name: windows64 / ubuntu-latest

    defaults:
      run:
        shell: bash

    steps:
      - uses: actions/checkout@v4

      - name: Install libraries
        run: |
          sudo apt-get install opencl-headers ocl-icd-opencl-dev libgmp-dev mingw-w64

      - name: Print GCC version
        run: |
          x86_64-w64-mingw32-gcc -v

      - name: Build OpenCL.dll
        run: |
          export CC=x86_64-w64-mingw32-gcc
          export CXX=x86_64-w64-mingw32-g++
          git clone --depth 1 https://github.com/KhronosGroup/OpenCL-ICD-Loader
          git clone --depth 1 https://github.com/KhronosGroup/OpenCL-Headers
          cd OpenCL-ICD-Loader
          mkdir build-mingw
          cd build-mingw
          cmake .. -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_C_COMPILER=x86_64-w64-mingw32-gcc -DOPENCL_ICD_LOADER_HEADERS_DIR=../../OpenCL-Headers -DCMAKE_RC_COMPILER=x86_64-w64-mingw32-windres -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=./install
          make -j
          make install

      - name: Build BOINC
        run: |
          export CC=x86_64-w64-mingw32-gcc
          export CXX=x86_64-w64-mingw32-g++
          cd ..
          git clone --depth 1 https://github.com/BOINC/boinc.git
          cd boinc
          ./_autosetup
          ./configure --host=x86_64-w64-mingw32 --with-boinc-platform="windows_x86_64" --disable-server --disable-manager --disable-client --enable-static CXXFLAGS="-O3"
          make -j

      - name: Build GMP
        run: |
          export CC=x86_64-w64-mingw32-gcc
          export CXX=x86_64-w64-mingw32-g++
          git clone --depth 1 https://github.com/gmp-mirror/gmp-6.3.git
          cd gmp-6.3
          ./.bootstrap
          ./configure --host=x86_64-w64-mingw32 --prefix=${GITHUB_WORKSPACE}/../gmp
          make -j
          make install

      - name: Build project
        working-directory: ./genefer
        run: |
          make -f makefile_windows_x64 -j CC=x86_64-w64-mingw32-g++ OCL_LIB=/home/runner/work/genefer22/genefer22/OpenCL-ICD-Loader/build-mingw/install/lib/libOpenCL.dll.a

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: windows64-latest
          retention-days: 1
          path: ./bin/*